# Copy to .env (never commit it). Secret values are marked. The README's configuration table explains each one.

# Sign-in (leave AUTH_MODE=none to run without it)
AUTH_MODE=none
CLERK_PUBLISHABLE_KEY=
VITE_CLERK_PUBLISHABLE_KEY=
CLERK_JWKS_URL=
CLERK_SECRET_KEY=                 # secret: only for tooling that calls Clerk's backend API

# Store
GW_STORE=memory                   # memory or hydradb
HYDRA_URL=http://hydradb:8443
HYDRA_TOKEN=                      # secret, at least thirty-two bytes

# Demo and limits
GW_DEMO_INCIDENTS=30
GW_PUBLIC_DEMO=0
GW_ADMIN_TOKEN=                   # secret
GW_RATE_LIMIT=0                   # requests/seconds, e.g. 60/60; 0 is off
GW_CORS_ORIGINS=                  # the frontend origin(s)

# LLM baseline and replays only (GhostWalk itself calls no LLM)
GEMINI_API_KEY=                   # secret
GROQ_API_KEY=                     # secret

# GitHub App (optional)
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=           # secret
GITHUB_WEBHOOK_SECRET=            # secret
GITHUB_PR_TOKEN=                  # secret
