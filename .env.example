
# Copy to .env (never commit it).
# See README configuration table for details.

# ==================================================
# SIGN-IN
# ==================================================
# none = local development without authentication
AUTH_MODE=none

CLERK_PUBLISHABLE_KEY=
VITE_CLERK_PUBLISHABLE_KEY=
CLERK_JWKS_URL=
CLERK_SECRET_KEY=                 # secret: Clerk backend tooling only

# ==================================================
# GHOSTWALK STORE
# ==================================================
GW_STORE=hydradb                  # hydradb or memory
GW_DEMO_INCIDENTS=30

# ==================================================
# HYDRADB
# ==================================================
HYDRA_URL=http://hydradb:8443
HYDRA_TOKEN=                      # secret: at least 32 bytes

# ==================================================
# MINIO OBJECT STORAGE
# ==================================================
HYDRA_CLOUD_PROVIDER=aws

MINIO_ROOT_USER=gwadmin
MINIO_ROOT_PASSWORD=              # secret: local MinIO administrator password

HYDRA_S3_KEY=ghostwalk-hydra
HYDRA_S3_SECRET=                  # secret: MinIO credentials for HydraDB
HYDRA_BUCKET=ghostwalk

# ==================================================
# DEMO, ADMIN AND RATE LIMITS
# ==================================================
GW_PUBLIC_DEMO=0
GW_ADMIN_TOKEN=                   # secret
GW_RATE_LIMIT=0
GW_CORS_ORIGINS=

# ==================================================
# LLM BASELINES AND REPLAYS
# GhostWalk itself does not call an LLM.
# ==================================================
GEMINI_API_KEY=                   # secret
GROQ_API_KEY=                     # secret

# ==================================================
# GITHUB APP (OPTIONAL)
# ==================================================
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=           # secret
GITHUB_WEBHOOK_SECRET=            # secret
GITHUB_PR_TOKEN=                  # secret
GITHUB_APP_SLUG=ghostwalk
